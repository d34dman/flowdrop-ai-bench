{
    "name": "flowdrop/ai-bench-runner",
    "description": "Minimal Drupal 11 site that runs the FlowDrop AI Bench cells.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/ai": "^1.4.7",
        "drupal/ai_agents": "1.3.x-dev",
        "drupal/ai_metering": "^1.0",
        "drupal/ai_provider_anthropic": "^1.2.2",
        "drupal/core-composer-scaffold": "^11.4.5",
        "drupal/core-recommended": "^11.4.5",
        "drupal/flowdrop": "2.x-dev#e061097",
        "drupal/flowdrop_agents": "^2",
        "drupal/flowdrop_ai_provider": "2.x-dev",
        "drupal/flowdrop_tool_provider": "^1.0@alpha",
        "drupal/flowdrop_ui": "^1.7",
        "drupal/flowdrop_ui-flowdrop_ui": "0.0.36",
        "drupal/flowdrop_ui_agents": "^2.0",
        "drupal/key": "^1.22",
        "drupal/modeler_api": "^1.1.5",
        "drush/drush": "^13.7.6"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/flowdrop": {
                "Make MemoryManager::MAX_VALUE_BYTES configurable (#3592436)": "patches/flowdrop-memory-configurable-max-value-bytes.patch"
            },
            "drupal/flowdrop_ai_provider": {
                "Chat/SimpleChat: drop the 4000 maxTokens cap; the benchmark needs whole-document outputs (the cap is arbitrary for current models)": "patches/flowdrop_ai_provider-chat-no-maxtokens-cap.patch"
            }
        }
    }
}
