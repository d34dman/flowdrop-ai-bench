From 1834221cf41da2aa67b661f45827b1d04afa9839 Mon Sep 17 00:00:00 2001
From: Shibin Das <shibinkidd@gmail.com>
Date: Sun, 6 Sep 2026 19:14:49 +0200
Subject: [PATCH] fix(node_processor): a tool with one text answer replies in
 plain text, not a JSON literal
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ToolInvoke rendered every result-less tool's data as json_encode($data). A
sub-workflow tool (URL to Markdown) answers with its leaf node's whole output,
{markdown, success, trigger, error}, so the model read a JSON string literal
with \n and \/ in it — and Claude Haiku 4.5 copied that literal back as its
final answer in the FlowDrop AI Bench (B7, 1 run in 3), a whole page on one
escaped line.

Now a result whose only substantive value is one string surfaces that string
as-is (framework ports success/trigger/tool/error/status, bools, nulls and
empties do not count), and data that does stay JSON is encoded with
JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE. A `result` key still wins.
---
 .../FlowDropNodeProcessor/ToolInvoke.php      | 63 ++++++++++++-
 .../tests/src/Kernel/ToolInvokeTest.php       | 93 +++++++++++++++++++
 2 files changed, 151 insertions(+), 5 deletions(-)

diff --git a/modules/flowdrop_node_processor/src/Plugin/FlowDropNodeProcessor/ToolInvoke.php b/modules/flowdrop_node_processor/src/Plugin/FlowDropNodeProcessor/ToolInvoke.php
index 48e82d70..d5dff826 100644
--- a/modules/flowdrop_node_processor/src/Plugin/FlowDropNodeProcessor/ToolInvoke.php
+++ b/modules/flowdrop_node_processor/src/Plugin/FlowDropNodeProcessor/ToolInvoke.php
@@ -115,6 +115,20 @@
   version: "1.1.0",
 )]
 class ToolInvoke extends AbstractFlowDropNodeProcessor implements ToolsAwareInterface, ExecutionContextAwareInterface {
+
+  /**
+   * Output ports every node carries that say nothing about the tool's answer.
+   *
+   * Excluded when deciding whether a result-less tool has one text answer
+   * (see {@see self::resultToString()}): a converter whose data is
+   * `{markdown, success, trigger, error}` has ONE answer, the markdown.
+   */
+  private const FRAMEWORK_OUTPUT_KEYS = ['success', 'trigger', 'tool', 'error', 'status'];
+
+  /**
+   * JSON flags for tool content the model reads: no `\/`, no `\uXXXX`.
+   */
+  private const JSON_FLAGS = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
   use ToolsAwareTrait;
 
   /**
@@ -362,9 +376,17 @@ public function process(ParameterBagInterface $params): array {
   /**
    * Render a tool result as the string content the model reads back.
    *
-   * A node's result whose data carries a `result` key surfaces that; any other
-   * tool's data is JSON-encoded. A failed result becomes an "Error: …" string
-   * the model can recover from.
+   * A node's result whose data carries a `result` key surfaces that. Without
+   * one, a result whose only substantive value is a single string — every
+   * other value a framework port ({@see self::FRAMEWORK_OUTPUT_KEYS}), a
+   * bool, a null, or empty — surfaces that string as-is: a converter or
+   * fetcher that answers with one document speaks to the model in plain
+   * text, not as a JSON string literal. Models copy what they read, and a
+   * model handed `{"markdown":"# Title\n\n..."}` has been observed to reply
+   * with the escaped literal, `\n` and `\/` included, as its final answer.
+   * Any other data is JSON-encoded, without escaping slashes or non-ASCII
+   * (`\/` and `\u2588` are noise to a model, and were likewise copied back).
+   * A failed result becomes an "Error: …" string the model can recover from.
    */
   private function resultToString(ToolResultInterface $result): string {
     if (!$result->isSuccess()) {
@@ -378,9 +400,40 @@ private function resultToString(ToolResultInterface $result): string {
       }
       // A non-stringable result falls back to the JSON encoding used for
       // result-less data below.
-      return (string) json_encode($resultValue);
+      return (string) json_encode($resultValue, self::JSON_FLAGS);
+    }
+    $single = self::singleTextAnswer($data);
+    if ($single !== NULL) {
+      return $single;
+    }
+    return (string) json_encode($data, self::JSON_FLAGS);
+  }
+
+  /**
+   * The one string a result-less tool answered with, if that is all it said.
+   *
+   * @param array<string, mixed> $data
+   *   The tool result data.
+   *
+   * @return string|null
+   *   The single non-empty string value, when every other value is a
+   *   framework port, a bool, a null, or empty; NULL otherwise.
+   */
+  private static function singleTextAnswer(array $data): ?string {
+    $text = NULL;
+    foreach ($data as $key => $value) {
+      if (in_array((string) $key, self::FRAMEWORK_OUTPUT_KEYS, TRUE)) {
+        continue;
+      }
+      if ($value === NULL || is_bool($value) || $value === '' || $value === []) {
+        continue;
+      }
+      if (!is_string($value) || $text !== NULL) {
+        return NULL;
+      }
+      $text = $value;
     }
-    return (string) json_encode($data);
+    return $text;
   }
 
   /**
diff --git a/modules/flowdrop_node_processor/tests/src/Kernel/ToolInvokeTest.php b/modules/flowdrop_node_processor/tests/src/Kernel/ToolInvokeTest.php
index 284a9c79..738e2528 100644
--- a/modules/flowdrop_node_processor/tests/src/Kernel/ToolInvokeTest.php
+++ b/modules/flowdrop_node_processor/tests/src/Kernel/ToolInvokeTest.php
@@ -231,4 +231,97 @@ public function testNoArtifactsMeansEmptyPort(): void {
     $this->assertSame([], $result['tool_artifacts']);
   }
 
+  /**
+   * A tool collection whose one tool answers with fixed result data.
+   *
+   * @param array<string, mixed> $data
+   *   The data the stub tool's ToolResult carries.
+   */
+  private function collectionAnswering(array $data): ToolCollection {
+    $invoker = new class($data) implements ToolInvokerInterface {
+
+      /**
+       * @param array<string, mixed> $data
+       *   The result data to answer with.
+       */
+      public function __construct(private readonly array $data) {}
+
+      /**
+       * {@inheritdoc}
+       */
+      public function invokeTool(string $nodeId, array $args): ToolResultInterface {
+        return ToolResult::success($this->data);
+      }
+
+    };
+    $binding = new ToolBinding(
+      'convert',
+      'cap_convert',
+      'Convert a page',
+      ['type' => 'object', 'properties' => []],
+      'Convert (cap_convert)',
+      $invoker,
+    );
+    return new ToolCollection([$binding]);
+  }
+
+  /**
+   * Invokes the `convert` tool once and returns the content the model reads.
+   *
+   * @param array<string, mixed> $data
+   *   The data the stub tool answers with.
+   */
+  private function contentFor(array $data): string {
+    $node = new ToolInvoke([], 'flowdrop_node_processor:tool_invoke', []);
+    $node->setTools($this->collectionAnswering($data));
+    $result = $node->process(new ParameterBag([
+      'tool_calls' => [
+        ['name' => 'convert', 'args' => [], 'tool_call_id' => 'c1'],
+      ],
+    ]));
+    $toolMessages = $this->assertArrayPathList($result, 'tool_messages');
+    $this->assertIsString($toolMessages[0]['content']);
+    return $toolMessages[0]['content'];
+  }
+
+  /**
+   * A result-less tool with one text answer speaks plain text, not JSON.
+   *
+   * A sub-workflow tool such as "URL to Markdown" answers with its leaf node's
+   * whole output — `{markdown, success, trigger, error}`. The model must read
+   * the markdown itself, not a JSON string literal with `\n` and `\/` in it:
+   * a model has been observed copying the escaped literal back as its final
+   * answer.
+   */
+  public function testSingleTextAnswerIsPlainText(): void {
+    $markdown = "# Title\n\nA [link](/a/b) and a glyph ████.";
+    $content = $this->contentFor([
+      'markdown' => $markdown,
+      'success' => TRUE,
+      'trigger' => TRUE,
+      'error' => NULL,
+    ]);
+    $this->assertSame($markdown, $content);
+  }
+
+  /**
+   * Two substantive values stay JSON, encoded without `\/` or `\uXXXX`.
+   */
+  public function testSeveralAnswersStayJsonUnescaped(): void {
+    $content = $this->contentFor([
+      'body' => '<p>a/b ████</p>',
+      'status_code' => 200,
+      'success' => TRUE,
+    ]);
+    $this->assertSame('{"body":"<p>a/b ████</p>","status_code":200,"success":true}', $content);
+  }
+
+  /**
+   * A non-string single value is not a text answer and stays JSON.
+   */
+  public function testSingleNonStringAnswerStaysJson(): void {
+    $this->assertSame('{"count":5,"success":true}', $this->contentFor(['count' => 5, 'success' => TRUE]));
+    $this->assertSame('{"items":["a","b"]}', $this->contentFor(['items' => ['a', 'b']]));
+  }
+
 }
